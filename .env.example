# ─────────────────────────────────────────────────────────────────────────────
# AdvWork-ERP — facturación electrónica SIMULADA. TODOS los valores son FICTICIOS.
# No existen credenciales reales del Ministerio de Hacienda en este proyecto.
#
# Uso: copiar este archivo a ".env" (que NO se versiona) y REINICIAR el servidor
# (el .env solo se lee al arrancar). Si un valor contiene "#", va entre comillas;
# de lo contrario el "#" se interpreta como comentario y trunca el valor.
# Con NODE_ENV=production las variables marcadas (*) son obligatorias y NO se
# aceptan las claves de desarrollo.
# Para correr los scripts con estos valores: node --env-file=.env scripts/<archivo>
# Guía completa: docs/seguridad-y-comunicacion.md
# ─────────────────────────────────────────────────────────────────────────────

# ── API SIMULADA de Hacienda (lado "servidor") ───────────────────────────────
# En producción la simulación está DESACTIVADA (responde 404) salvo que se fuerce:
# HACIENDA_SIM_ENABLED=true
HACIENDA_SIM_USER="SIM-FACTURADOR-01"                          # (*)
HACIENDA_SIM_PWD="SIM-NO-REAL-Pwd#2026"                        # (*)
HACIENDA_SIM_JWT_SECRET="cambia-este-secreto-jwt-no-real"      # (*)
HACIENDA_SIM_FIRMA_SECRET="cambia-este-secreto-firma-no-real"  # (*)
HACIENDA_SIM_TOKEN_TTL_HOURS=12      # vigencia del token (12)
HACIENDA_SIM_DATA_DIR=data           # carpeta del JSON de la simulación (data)
HACIENDA_SIM_TIMEOUT_MS=6000         # demora de los escenarios timeout (6000)

# ── Backend del ERP (lado "cliente" de Hacienda) ─────────────────────────────
# USER, PWD y FIRMA_SECRET deben COINCIDIR con los HACIENDA_SIM_* de arriba.
ERP_DTE_USER="SIM-FACTURADOR-01"                               # (*)
ERP_DTE_PWD="SIM-NO-REAL-Pwd#2026"                             # (*)
ERP_DTE_FIRMA_SECRET="cambia-este-secreto-firma-no-real"       # (*)
# URL de la API de Hacienda. Debe ser https:// (http:// solo en localhost).
# (*) OBLIGATORIA en producción. En desarrollo, si se omite, se usa el propio servidor
# (solo cuando se accede por localhost / 127.0.0.1 / ::1).
# ERP_DTE_API_URL="http://127.0.0.1:8080/api/hacienda-sim"
ERP_DTE_TIMEOUT_MS=5000              # espera por respuesta (5000 = umbral oficial)
ERP_DTE_MAX_REINTENTOS=2             # reenvíos tras el primero (2 = máximo oficial)
ERP_DTE_DATA_DIR=data                # carpeta de la bitácora del ERP (data)

# ── Control de acceso del backend del ERP (anti DNS-rebinding / anti-CSRF) ───
# Por defecto SOLO se atiende a localhost. Si el ERP se publica en un dominio o se abre desde
# otra máquina por IP, hay que declarar ese host; de lo contrario responderá 403.
# ERP_DTE_ALLOWED_HOSTS="erp.midominio.com,192.168.1.50"
# Detrás de un proxy que cambia el esquema/host, declara el origen público del navegador:
# ERP_DTE_ALLOWED_ORIGINS="https://erp.midominio.com"     # solo en desarrollo: redirige todos los correos aquí
